#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=8,local_size_y=8) in;
layout(set=2,binding=4,rgba16f) uniform writeonly image2D cloudShadowField;
#define COMPUTE_PASS
#define BUILD_CLOUD_SHADOW
#include "parameters.glsl"
#include "common.glsl"
#include "cloud-density.glsl"
#include "cloud-shadow-coordinates.glsl"

void main() {
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy),size=imageSize(cloudShadowField);
    if(any(greaterThanEqual(pixel,size))) return;
    ivec2 tileSize=size/2;
    int cascade=pixel.x/tileSize.x,lobe=pixel.y/tileSize.y;
    vec2 uv=(vec2(pixel%tileSize)+0.5)/vec2(tileSize);
    float halfSpan=cloudShadowSpan(cascade);
    vec2 xy=cloudShadowCenter(cascade)+(uv*2.0-1.0)*halfSpan;
    vec2 height=cloudShadowHeights(xy); // inner and outer shell intersections
    float span=height.y-height.x;
    vec4 knots=vec4(0);
    if(span>0.0001&&cloud.layer.w>0.0) {
        vec3 sun=cloudShadowSun();
        vec3 tangent=planetData.cloudShadowU.xyz*xy.x+planetData.cloudShadowV.xyz*xy.y;
        float top=lobe==0?height.y:-height.x;
        int steps=int(clamp(ceil(span/(4.0*0.2)),4.0,16.0));
        float dt=span/(4.0*float(steps));
        float footprint=max(halfSpan/float(tileSize.x),dt*0.5);
        float tau=0.0;
        for(int k=0;k<4;k++) {
            if(tau<16.0) {
                for(int j=0;j<steps;j++) {
                    float distance=(float(k*steps+j)+0.5)*dt;
                    vec3 p=tangent+sun*(top-distance);
                    tau+=cloudDensity(p,true,footprint)*cloud.layer.z*dt;
                }
            }
            knots[k]=min(tau,16.0);
        }
    }
    imageStore(cloudShadowField,pixel,knots);
}
