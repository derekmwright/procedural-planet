#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=8,local_size_y=8) in;
layout(set=2,binding=0) uniform sampler2D sourceLight;
layout(set=2,binding=1) uniform sampler2D sourceTransmission;
layout(set=2,binding=4,rgba16f) uniform writeonly image2D filteredLight;
layout(set=2,binding=5,rgba16f) uniform writeonly image2D filteredTransmission;
layout(set=2,binding=12,std140) uniform FilterLevel { ivec4 data; } filterLevel;
#define COMPUTE_PASS
#include "parameters.glsl"
#define BUILD_CLOUD_SHADOW
#include "common.glsl"
#include "water-sky-coordinates.glsl"
void main() {
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(pixel,imageSize(filteredLight)))) return;
    int level=filterLevel.data.x,face=0; ivec2 local;
    if(!waterSkyTexel(pixel,level,face,local)) {
        imageStore(filteredLight,pixel,texelFetch(sourceLight,pixel,0));
        imageStore(filteredTransmission,pixel,texelFetch(sourceTransmission,pixel,0));
        return;
    }
    vec3 light=vec3(0),transmit=vec3(0); float total=0.0;
    // Four taps from the previous level; no long serial loops for coarse mips.
    // Use the same continuous face reconstruction as the water shader, so
    // independently marched gutters cannot propagate seams into coarse mips.
    for(int y=0;y<2;y++) for(int x=0;x<2;x++) {
        vec2 p=(vec2(local*2+ivec2(x,y))+0.5)/float(waterSkySize(level-1))*2.0-1.0;
        vec3 dir=waterSkyDirection(face,p);
        float weight=pow(1.0+dot(p,p),-1.5);
        light+=waterSkySample(sourceLight,dir,level-1).rgb*weight;
        transmit+=waterSkySample(sourceTransmission,dir,level-1).rgb*weight;
        total+=weight;
    }
    imageStore(filteredLight,pixel,vec4(light/total,1));
    imageStore(filteredTransmission,pixel,vec4(transmit/total,1));
}
