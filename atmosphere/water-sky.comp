#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=8,local_size_y=8) in;
layout(set=2,binding=4,rgba16f) uniform writeonly image2D skyLight;
layout(set=2,binding=5,rgba16f) uniform writeonly image2D skyTransmission;
#define COMPUTE_PASS
uvec2 cloudPixel;
#define AIR_SAMPLE_PIXEL cloudPixel
#include "air-frame.glsl"
#include "parameters.glsl"
#include "engine-lighting.glsl"
#include "common.glsl"
#include "cloud-density.glsl"
#include "cloud-march.glsl"
#include "water-sky-coordinates.glsl"

void main() {
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(pixel,imageSize(skyLight)))) return;
    int face; ivec2 local;
    if(!waterSkyTexel(pixel,0,face,local)) {
        imageStore(skyLight,pixel,vec4(0));
        imageStore(skyTransmission,pixel,vec4(1));
        return;
    }
    vec3 dir=waterSkyDirection(face,(vec2(local)+0.5)/float(WATER_SKY_SIZE)*2.0-1.0);
    vec3 origin=waterSkyOrigin(),up=normalize(origin),sun=normalize(pc.sunDir.xyz);
    // Extend the sky smoothly below the local tangent for the roughness filter.
    // The analytic water receiver itself never reflects into the planet.
    dir=normalize(dir-2.0*min(dot(dir,up),0.0)*up);
    cloudPixel=uvec2(pixel);
    float endpoint=PLANET_RADIUS*8.0,cone=2.0/float(WATER_SKY_SIZE);
    vec4 intervals=cloudIntervals(origin,dir,endpoint);
    Air result=Air(vec3(0),vec3(1));
    float cursor=0.0;
    if(cloud.layer.w>0.0) {
        for(int j=0;j<2;j++) {
            vec2 segment=j==0?intervals.xy:intervals.zw;
            if(segment.y<=segment.x) continue;
            appendAir(result,integrateAir(origin+dir*cursor,dir,segment.x-cursor,sun,pc.sunColor.rgb));
            marchCloud(result,origin,dir,sun,segment,cone);
            cursor=segment.y;
        }
    }
    appendAir(result,integrateAir(origin+dir*cursor,dir,max(endpoint-cursor,0.0),sun,pc.sunColor.rgb));
    imageStore(skyLight,pixel,vec4(result.light,1));
    imageStore(skyTransmission,pixel,vec4(result.transmittance,1));
}
